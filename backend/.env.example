# RepairVerse AI - Backend Environment Variables
# Copy this file to .env or pass these as environment variables in production.
# NEVER commit real production secrets to version control.

# Server Configuration
PORT=8080

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/repairversedb
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000

# JWT Security (Minimum 256-bit / 32-character secret key)
JWT_SECRET=replace_with_a_secure_random_base64_encoded_256_bit_secret_key
JWT_EXPIRATION_MS=86400000

# Google Gemini AI API Configuration (Phase 15)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Cloudinary Storage Configuration (Phase 15+)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
